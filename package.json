{
  "name": "rgdev-app-flujo-efectivo-iglesia",
  "private": true,
  "version": "1.11.0",
  "description": "Sistema moderno de tesorería y mayordomía financiera eclesiástica con React, TypeScript, Vite, Tailwind CSS, PostgreSQL en Aiven Cloud y Cloudflare R2 bajo Apple Human Interface Guidelines (HIG).",
  "author": "David Méndez <DEMG-DEV>",
  "license": "MIT",
  "homepage": "https://github.com/DEMG-DEV/RGDev.App.FlujoEfectivo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEMG-DEV/RGDev.App.FlujoEfectivo.git"
  },
  "bugs": {
    "url": "https://github.com/DEMG-DEV/RGDev.App.FlujoEfectivo/issues"
  },
  "keywords": [
    "tesoreria",
    "iglesia",
    "finanzas-eclesiasticas",
    "mayordomia",
    "flujo-de-efectivo",
    "diezmos",
    "ofrendas",
    "proyectos-pactados",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "postgresql",
    "aiven",
    "cloudflare-r2",
    "apple-hig"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/flujo_efectivo AIVEN_PG_URL=postgres://postgres:postgres@localhost:5433/flujo_efectivo vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d db",
    "docker:logs": "docker compose logs -f",
    "docker:backup": "./docker/backup-from-prod.sh",
    "docker:restore": "./docker/restore-to-local.sh",
    "backup:r2": "node --env-file=.env scripts/backup-db-to-r2.js"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^16.0.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
