# ==============================================================================
# Flujo de Efectivo Eclesiástico - Plantilla de Variables de Entorno
# ==============================================================================
# Copie este archivo a '.env' y configure las credenciales según su entorno.
# NUNCA suba su archivo '.env' real al control de versiones de Git.

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Aiven Cloud en Producción / Local Docker en Dev)
# ------------------------------------------------------------------------------
# Para producción en Aiven:
# DATABASE_URL=postgres://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require
# AIVEN_PG_URL=postgres://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require

# Para desarrollo local con contenedor Docker (puerto 5433):
DATABASE_URL=postgres://postgres:postgres@localhost:5433/flujo_efectivo
AIVEN_PG_URL=postgres://postgres:postgres@localhost:5433/flujo_efectivo

# ------------------------------------------------------------------------------
# 2. Autenticación y Criptografía (Auth.js / NextAuth / JWT)
# ------------------------------------------------------------------------------
# Secreto para firmar tokens y sesiones (genere una cadena aleatoria con: openssl rand -base64 32)
AUTH_SECRET=su_secreto_super_seguro_de_32_caracteres_o_mas
NEXTAUTH_SECRET=su_secreto_super_seguro_de_32_caracteres_o_mas
NEXTAUTH_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Almacenamiento de Evidencias (Cloudflare R2 Object Storage - Bucket "gospel")
# ------------------------------------------------------------------------------
# Obtenga estas credenciales desde Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=su_cloudflare_account_id
R2_ACCESS_KEY_ID=su_r2_access_key_id
R2_SECRET_ACCESS_KEY=su_r2_secret_access_key
R2_BUCKET_NAME=gospel
# URL pública o dominio personalizado para servir comprobantes
R2_PUBLIC_URL=https://pub-<ID>.r2.dev

# ------------------------------------------------------------------------------
# 4. Configuración del Servidor y Entorno
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5173
